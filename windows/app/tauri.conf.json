{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Free Scribe",
  "version": "0.1.0",
  "identifier": "local.freescribe.app",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Free Scribe",
        "width": 760,
        "height": 560,
        "minWidth": 680,
        "minHeight": 480,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/128x128.png"]
  }
}
